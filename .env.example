# ============================================================================
# Dota Analyst — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# This file documents every variable the codebase reads.
# ============================================================================

# ----------------------------------------------------------------------------
# API keys for external services
# ----------------------------------------------------------------------------

# Steam Web API key (https://steamcommunity.com/dev/apikey)
# Used for: GetLiveLeagueGames (live match discovery)
# Without it, Steam-based live discovery is disabled (the rest still works).
STEAM_API_KEY=

# Stratz GraphQL token (https://stratz.com/api)
# Used for: detailed draft / lane data (planned for 0.2.x)
STRAZT_API_KEY=

# DatDota API (https://api.datdota.com)
# Used for: ML data collection. No key required, but the 500 req/day
# budget is enforced. Contact Noxville on Discord for higher limits.
DATDOTA_API_KEY=

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------

# Static dev token expected in the `X-API-Key` header on every request.
# Required from 0.0.2 onward. Generate with: openssl rand -hex 32
DEV_API_KEY=dev-token-change-me

# ----------------------------------------------------------------------------
# HTTP / CORS
# ----------------------------------------------------------------------------

# Comma-separated list of allowed origins for browser requests.
# Default for local dev: just the web node (nginx on :80).
# Example prod: https://dota.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8000

# Max request body size in bytes (default 1 MB). Anything larger is rejected.
MAX_BODY_BYTES=1048576

# Max SSE message size in bytes (default 64 KB).
MAX_SSE_BYTES=65536

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------

# Per-key requests-per-minute. Set to 0 to disable rate limiting in dev.
RATE_LIMIT_RPM=60

# Per-key burst size (token-bucket capacity).
RATE_LIMIT_BURST=10

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Log format: json | text. JSON is recommended for prod (pipe to log
# aggregator), text is friendlier in local dev.
LOG_FORMAT=text

# ----------------------------------------------------------------------------
# ML / prediction
# ----------------------------------------------------------------------------

# Which prediction engine to use.
# Allowed: heuristic | ml
# - `heuristic` (default): pure rule-based, no model file needed
# - `ml`:  loads the latest version of `winner` from MODEL_DIR; falls
#         back to heuristic if no model is found
# `ensemble` is planned for 0.2.x and currently not supported.
PREDICTION_ENGINE=heuristic

# Where to look for trained model artifacts. Default: ml_data/models/
MODEL_DIR=ml_data/models

# Trigger threshold for retraining: number of new matches since last
# train that should accumulate before we retrain. 0 disables.
RETRAIN_THRESHOLD=1000

# ----------------------------------------------------------------------------
# Caching / refresh intervals
# ----------------------------------------------------------------------------

# DLTV v1 /events cache TTL in seconds (default 15 min).
DLTV_EVENTS_TTL=900

# DLTV v1 /events/{id}/series cache TTL in seconds (default 45 sec — series change fast).
DLTV_SERIES_TTL=45

# Discovery scraper refresh TTL in seconds.
DISCOVERY_SCRAPE_TTL=90

# Steam live-games refresh TTL in seconds.
STEAM_LIVE_TTL=30

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Bind host (default 0.0.0.0 for Docker; localhost for tight dev).
HOST=0.0.0.0

# HTTP port.
PORT=8000

# Number of uvicorn workers. 1 for dev (reload), 4+ for prod.
WORKERS=1
