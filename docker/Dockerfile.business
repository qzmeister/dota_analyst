# Business — FastAPI service hosting the heuristic + future ML.
# Internal-only; only the gateway talks to it.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /app app
WORKDIR /app

COPY pyproject.toml ./
# Both packages must be present before `pip install .` because
# pyproject.toml's `packages = ["gateway", "business", "business.ml"]`
# makes setuptools scan all of them at build time.
COPY gateway/ ./gateway/
COPY business/ ./business/
# Install in two stages to avoid the 303 MB nvidia-nccl-cu12 GPU
# library that xgboost declares as a dependency.  We use --no-deps
# for xgboost on the second pass; the first pass has already
# pulled in numpy/scipy/etc., so the runtime is complete.
#
# v0.3.20: install Playwright + chromium for the live match-state
# scraper.  DLTV's v1 API doesn't return in-progress series; the
# only source for live picks/score is the rendered HTML page at
# /matches/{series_id}/{slug}, which we fetch via Playwright.  The
# chromium binary is 200 MB; it's the price of having real picks
# on the board during a live game.
RUN pip install --upgrade pip && \
    pip install . && \
    pip install --force-reinstall --no-deps "xgboost>=3.0" && \
    pip install "playwright>=1.40" && \
    playwright install chromium --with-deps

# Mount the ml_data/ directory at runtime; the image stays clean.
RUN mkdir -p /app/ml_data && chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/healthz', timeout=3).read()" || exit 1

CMD ["uvicorn", "business.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
