# Business — FastAPI service hosting the heuristic + future ML.
# Internal-only; only the gateway talks to it.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /app app
WORKDIR /app

COPY pyproject.toml ./
# Both packages must be present before `pip install .` because
# pyproject.toml's `packages = ["gateway", "business", "business.ml"]`
# makes setuptools scan all of them at build time.
COPY gateway/ ./gateway/
COPY business/ ./business/
# `--no-deps` for our own wheel keeps xgboost from pulling the 303 MB
# nvidia-nccl-cu12 GPU-only library (we run CPU-only).  Same `--no-deps`
# for xgboost itself, since its declared deps include nvidia-nccl-cu12
# for GPU support that we don't need.  We install the CPU runtime
# deps (numpy/scipy) explicitly, then xgboost+sklearn+joblib skip
# their GPU transitive deps.
RUN pip install --upgrade pip && \
    pip install --no-deps . && \
    pip install "scipy>=1.10" "numpy>=1.24" && \
    pip install --no-deps "xgboost>=3.0" "scikit-learn>=1.3" "joblib>=1.3"

# Mount the ml_data/ directory at runtime; the image stays clean.
RUN mkdir -p /app/ml_data && chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/healthz', timeout=3).read()" || exit 1

CMD ["uvicorn", "business.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
