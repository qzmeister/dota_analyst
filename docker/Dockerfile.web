# Web (frontend) — nginx serving the static bundle.
# This image has NO Python. It's pure nginx + HTML/CSS/JS.

FROM nginx:1.27-alpine

# Wipe the default nginx site
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy our config
COPY web/nginx.conf /etc/nginx/nginx.conf

# Copy the static frontend
COPY web/public/ /usr/share/nginx/html/

# Add a non-root user for runtime
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /usr/share/nginx/html /var/cache/nginx

USER nginx

EXPOSE 80

# Healthcheck — /healthz returns 200 from nginx itself
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

# CMD inherited from base image (nginx -g 'daemon off;')
